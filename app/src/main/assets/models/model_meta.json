{
  "name": "callguard-asvspoof-itw-cnn",
  "version": "0.4.0",
  "training": {
    "dataset": "ASVspoof 2019 LA + In-the-Wild",
    "asvspoof_clips": 400,
    "in_the_wild_clips": 200,
    "train_clips": 26679,
    "validation_clips": 200,
    "cross_clips": 100,
    "cross_dataset": "garystafford/deepfake-audio-detection (CC-BY-4.0)",
    "epochs": 2,
    "seconds": 59.4,
    "device": "cuda"
  },
  "metrics": {
    "headline_eer": 0.005,
    "headline_set": "garystafford cross-dataset",
    "validation_eer": 0.41,
    "validation_accuracy": 0.59,
    "cross_dataset_eer": 0.005,
    "cross_dataset_accuracy": 0.99,
    "tflite_validation_eer": 0.41,
    "tflite_cross_dataset_eer": 0.005,
    "eer_threshold": 0.638916,
    "calibrated_threshold": 0.5,
    "calibrated_held_out_accuracy": 0.98
  },
  "per_source": {
    "real": {
      "clips": 50,
      "mean_score": 0.0212,
      "flagged_rate": 0.0
    }
  },
  "per_source_set": "held-out half of garystafford, calibrated P(fake) >= 0.5",
  "calibration": {
    "method": "platt",
    "a": 0.312292,
    "b": -3.782733,
    "fit_on": "disjoint half of garystafford cross-dataset",
    "held_out_eer": 0.01,
    "held_out_accuracy": 0.98,
    "note": "applies sigmoid(a*logit(p)+b); strictly monotone, so it cannot change the measured EER."
  },
  "caveat": "Trained on ASVspoof 2019 LA and In-the-Wild, validated on a speaker-disjoint dev split and on a separate CC-BY corpus. Real phone calls, unseen generators and adversarial audio are not validated. Treat the score as a hint, not proof.",
  "purpose": "Research demo. Not a security control.",
  "input_shape": [
    1,
    64,
    198,
    1
  ],
  "output": "calibrated P(fake) in [0,1]; 0.5 is the fitted operating point",
  "dsp": {
    "sample_rate": 16000,
    "n_fft": 512,
    "win": 400,
    "hop": 160,
    "n_mel": 64,
    "fmin": 20.0,
    "fmax": 8000.0,
    "floor": 1e-06,
    "window_seconds": 2.0,
    "frames": 198,
    "normalization": "z-score over the whole window"
  },
  "params": 201761,
  "size_kib": 222.8
}
