  "caveat": "Trained on ASVspoof 2019 LA (TTS/VC attacks), validated on its speaker-disjoint dev set and on a separate CC-BY corpus. Real phone calls, unseen generators and adversarial audio are not validated. Treat the score as a hint, not proof.",
  "purpose": "Research demo. Not a security control.",
  "input_shape": [
    1,
    64,
    198,
    1
  ],
  "output": "calibrated P(fake) in [0,1]; 0.5 is the fitted operating point",
  "dsp": {
    "sample_rate": 16000,
    "n_fft": 512,
    "win": 400,
    "hop": 160,
    "n_mel": 64,
    "fmin": 20.0,
    "fmax": 8000.0,
    "floor": 1e-06,
    "window_seconds": 2.0,
    "frames": 198,
    "normalization": "z-score over the whole window"
  },
  "params": 193569,
  "size_kib": 214.8,
  "calibration": {
    "method": "platt",
    "a": 0.492985,
    "b": 3.74206,
    "fit_on": "disjoint half of garystafford cross-dataset (933 real / 933 fake)",
    "held_out_eer": 0.29154,
    "held_out_accuracy": 0.70847,
    "note": "applies sigmoid(a*logit(p)+b); monotone, so EER is unchanged. Picks the operating point for unseen-generator audio."
  }
